# Copy to .env and adjust as needed — all of these have working defaults
# for this machine already, so an empty .env is fine too.

# Obsidian vault Rocky reads/writes notes in (agent/obsidian.py).
# Default (if unset): /Users/hemanthsarode/Hexo's vault/Hexo's Vault
#ROCKY_VAULT_PATH=/path/to/your/vault

# Local checkout of the GIT_MCP server Rocky's GitHub tools call into
# (agent/github_mcp.py). Default (if unset): ~/GIT_MCP
#GIT_MCP_PATH=/path/to/GIT_MCP

# kokoro-onnx TTS model files (voice/speak.py). Defaults (if unset): the
# matching files already sitting in voice/.
#KOKORO_MODEL_PATH=voice/kokoro-v1.0.fp16.onnx
#KOKORO_VOICES_PATH=voice/voices-v1.0.bin

# Re-enables the pitch-shift/ring-modulation "alien synthesizer" voice
# effect (voice/robot_effect.py) — off by default since the personality
# pivoted to young/playful/sarcastic and it read as "too heavy" for that.
#ROCKY_ROBOT_VOICE=0

# Required for web_search/fetch_url (agent/web.py) — the one deliberate
# exception to Rocky's fully-local design, for anything past the model's
# training cutoff. Free tier, no card required: tavily.com -> sign up ->
# dashboard -> API key. Without this set, both tools return a plain
# "not configured" message instead of failing hard.
TAVILY_API_KEY=

# --- Unused (voice/wake_word.py is currently dead code — push-to-talk
# replaced always-on wake-word listening; kept only in case it's revived) ---
#ROCKY_WAKEWORD_MODEL_PATH=voice/rocky_wakeword.onnx
#ROCKY_WAKEWORD_THRESHOLD=0.5
#ROCKY_STOP_MODEL_PATH=voice/stop_wakeword.onnx
