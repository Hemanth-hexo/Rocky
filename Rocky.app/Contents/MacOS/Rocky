#!/bin/bash
# Rocky.app's launcher — fully self-contained: does NOT read or execute any
# file outside this bundle (macOS's file-provenance tracking blocks that
# from an app's own process — "Operation not permitted" on both cp and
# exec of files this app didn't create). The plist content is embedded
# directly below and written fresh instead of copied.
#
# If Rocky is already running, brings its window to the front. Otherwise
# starts it under launchd (survives crashes; quitting via Cmd+Q/Quit and
# reopening this app both work normally).
#
# ROOT CAUSE FOUND (2026-09-15): a cold start via `open`/double-click (as
# opposed to running bootstrap+kickstart from an interactive Terminal
# shell, where it's near-instant) genuinely takes launchd about 10 seconds
# to actually spawn the process — confirmed by timing it directly and by
# `launchctl print` showing `state = spawn scheduled` / `active count = 0`
# for that whole window before it flips to `running`. The polling loop
# below used to give up after only 2 seconds (4 x 0.5s) and fall through
# to a raw `nohup` background start — which then raced/conflicted with the
# launchd spawn actually completing a few seconds later, and independently
# wasn't reliably surviving being spawned from this unsigned app's process
# context anyway. Waiting long enough for the real launchd spawn to finish
# is the actual fix; the nohup path below is now just a last-resort safety
# net that should rarely if ever be reached.
ROCKY_DIR="/Users/hemanthsarode/Desktop/PROJECTS/Rocky"
PLIST_DEST="/Users/hemanthsarode/Library/LaunchAgents/com.rocky.desktopapp.plist"

is_running() {
    pgrep -f "$ROCKY_DIR/desktop_app.py" >/dev/null 2>&1
}

if is_running; then
    PID=$(pgrep -f "$ROCKY_DIR/desktop_app.py" | head -1)
    osascript -e "tell application \"System Events\" to set frontmost of first process whose unix id is $PID to true"
    exit 0
fi

cat > "$PLIST_DEST" << 'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.rocky.desktopapp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/hemanthsarode/Desktop/PROJECTS/Rocky/venv/bin/python3</string>
		<string>/Users/hemanthsarode/Desktop/PROJECTS/Rocky/desktop_app.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/hemanthsarode/Desktop/PROJECTS/Rocky</string>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/hemanthsarode/Desktop/PROJECTS/Rocky/rocky.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/hemanthsarode/Desktop/PROJECTS/Rocky/rocky.log</string>
</dict>
</plist>
PLIST_EOF

launchctl bootstrap "gui/$(id -u)" "$PLIST_DEST" 2>/dev/null
launchctl kickstart -k "gui/$(id -u)/com.rocky.desktopapp" 2>/dev/null

# Give the supervised start up to ~20s (a real cold start via launchd
# takes ~10s — see note above) before falling back to a direct launch so
# the user isn't stuck with a dead double-click in the rare case launchd
# itself never comes through.
for i in $(seq 1 40); do
    sleep 0.5
    if is_running; then
        exit 0
    fi
done

cd "$ROCKY_DIR"
nohup "$ROCKY_DIR/venv/bin/python3" "$ROCKY_DIR/desktop_app.py" >> "$ROCKY_DIR/rocky.log" 2>&1 &
